DATABASE_URL="postgresql://postgres:postgres@localhost:5432/copita?schema=public&options=-c%20timezone%3DUTC"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Mercado Pago (OAuth marketplace app: https://www.mercadopago.com.ar/developers/panel)
MP_CLIENT_ID=""
MP_CLIENT_SECRET=""
MP_WEBHOOK_SECRET=""
MP_USE_SANDBOX="true"

# Comisión de la plataforma sobre cada copita (ver packages/db y src/lib/platform-fee.ts)
PLATFORM_FEE_TYPE="percent"
PLATFORM_FEE_VALUE="5"

# Cotización USD->ARS de referencia para copitas ("copita = ~$1 USD").
# Se intenta primero la API pública de dolarapi.com (tipo de cambio oficial); si falla, se usa este valor fijo.
USD_ARS_FALLBACK_RATE="1000"

# Seguridad
TOKEN_ENCRYPTION_KEY="replace-with-64-hex-characters"
SESSION_SECRET="change-me-with-at-least-32-random-characters"

# Emails con acceso a /admin (panel interno, Fase 6), separados por coma
PLATFORM_ADMIN_EMAILS="admin@copita.ar"

# SMTP para verificación de email y recuperación de contraseña (src/lib/mail.ts).
# Sin esto configurado, los emails no se envían: el link queda logueado en la
# consola del servidor para poder probar el flujo igual.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="no-responder@copita.ar"
